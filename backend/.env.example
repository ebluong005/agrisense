# Copy to backend/.env (git-ignored) and fill in. Never commit real values.

# local | test | staging | production
# staging/production refuse to start with the default JWT secret or with SQLite.
APP_ENV=local

# --- Database -------------------------------------------------------------
# Option A: zero-setup local demo (no PostGIS; fine for UI/API work):
DATABASE_URL=sqlite:///./agrisense.db
#
# Option B: Supabase dev project (target). Copy from Supabase dashboard ->
# Connect. "postgresql://" is accepted and mapped to the psycopg 3 driver.
# Session pooler (IPv4-friendly, port 5432), recommended for the API:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
# Transaction pooler (port 6543): prepared statements are disabled automatically.
#
# Optional: separate URL used only by Alembic migrations (direct connection or
# session pooler; avoid the transaction pooler). Defaults to DATABASE_URL.
# DATABASE_MIGRATION_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
#
# URL-encode special characters in the password (e.g. @ -> %40, # -> %23).

# SQLAlchemy pool per API process; keep small to fit Supabase connection limits.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2

# --- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_LOCAL_DEVELOPMENT_ONLY

# --- HTTP -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Weather provider -----------------------------------------------------
# Defaults to the real NASA POWER daily point API; browser tests point it at e2e/fake_nasa.py.
# NASA_POWER_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# --- Optional providers (P1; leave empty to keep NDVI disabled) -----------
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
