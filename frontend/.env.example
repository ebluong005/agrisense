# Copy to frontend/.env.local. Vite exposes only VITE_* variables, and every one
# of them is bundled into public browser JavaScript.
# NEVER put the Supabase secret key, service_role key or database password here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# FastAPI origin. Leave empty locally (Vite proxies /api to 127.0.0.1:8000).
# On Vercel set it to the Render API origin, e.g. https://agrisense-api.onrender.com
VITE_API_BASE_URL=
